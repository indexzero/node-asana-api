{
  "name": "asana-api",
  "description": "A small, zero-dependency Node.js client for the Asana API",
  "version": "1.0.0",
  "author": "Charlie Robbins <charlie.robbins@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/indexzero/node-asana-api.git"
  },
  "bugs": {
    "url": "https://github.com/indexzero/node-asana-api/issues"
  },
  "homepage": "https://github.com/indexzero/node-asana-api#readme",
  "keywords": [
    "asana",
    "api",
    "project management"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/asana-api.d.ts",
      "default": "./lib/asana-api.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./lib/asana-api.js",
  "types": "./dist/asana-api.d.ts",
  "files": [
    "lib",
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "test": "node --test \"test/*.test.js\" \"test/*.test.cjs\""
  },
  "engines": {
    "node": ">=24"
  }
}
