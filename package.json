{
  "name": "asana-api",
  "description": "A small, zero-dependency Node.js client for the Asana API",
  "version": "1.0.0",
  "author": "Charlie Robbins <charlie.robbins@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/indexzero/node-asana-api.git"
  },
  "bugs": {
    "url": "https://github.com/indexzero/node-asana-api/issues"
  },
  "homepage": "https://github.com/indexzero/node-asana-api#readme",
  "keywords": [
    "asana",
    "api",
    "project management"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/asana-api.d.ts",
      "default": "./lib/asana-api.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./lib/asana-api.js",
  "types": "./dist/asana-api.d.ts",
  "files": [
    "lib",
    "dist",
    "CHANGELOG.md",
    "MIGRATION.md"
  ],
  "sideEffects": false,
  "scripts": {
    "test": "node --test \"test/*.test.js\" \"test/*.test.cjs\"",
    "test:coverage": "node --test --experimental-test-coverage \"test/*.test.js\" \"test/*.test.cjs\"",
    "lint": "biome ci --error-on-warnings",
    "lint:fix": "biome check --write",
    "build:types": "tsc -p tsconfig.json",
    "check:types": "tsc -p tsconfig.types.json",
    "check": "pnpm run lint && pnpm run build:types && pnpm run check:types",
    "prepack": "pnpm run build:types",
    "prepublishOnly": "pnpm run check && pnpm test"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@types/node": "^24.19.2",
    "typescript": "7.0.2"
  },
  "packageManager": "pnpm@10.34.0"
}
